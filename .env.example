# ─── Database ────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password

# ─── Telegram ────────────────────────────────────────────────
TG_BOT_TOKEN=7123456789:AAF...
TG_GROUP_ID=-1001234567890

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Grafana ─────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ─── Server ──────────────────────────────────────────────────
DOMAIN=monitor.yourdomain.com
# Секретний ключ для підпису JWT (генерується один раз: openssl rand -hex 32)
SECRET_KEY=change_me_secret_key

# ─── Alerts ──────────────────────────────────────────────────
ALERT_COOLDOWN_MIN=30
DAILY_REPORT_HOUR=10

# ─── Dashboard / Auth ────────────────────────────────────────
# Публічний URL (для magic-link у Telegram). Має співпадати з DOMAIN під HTTPS.
PUBLIC_URL=https://monitor.yourdomain.com
# Telegram user_id кому дозволено вхід у дашборд (через кому).
# Свій id можна дізнатись у бота @userinfobot
DASHBOARD_ADMINS=123456789
# Час життя сесії дашборду (годин) і одноразового login-токена (хвилин)
SESSION_TTL_HOURS=8
LOGIN_TOKEN_TTL_MIN=5
# Секрет для реєстрації агентів (openssl rand -hex 16). Вводиться один раз
# при налаштуванні кожного агента через register_agent.py
REGISTER_SECRET=change_me_register_secret
# Окремий секрет для внутрішнього виклику бот→API (/api/auth/login-token).
# Якщо не заданий — використовується SECRET_KEY (сумісність). Рекомендовано
# задати власне значення: openssl rand -hex 32
INTERNAL_SECRET=change_me_internal_secret
